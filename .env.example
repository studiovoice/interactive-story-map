# Copy to .env.local to override. Everything has a working default.

# ── Persistence ──────────────────────────────────────────────────────────────
# "json" = one file on disk (no setup). "drizzle" = Postgres (run `pnpm services:up`,
# then `pnpm db:migrate && pnpm db:seed`). See docs/plans/postgres-and-s3.md.
DATA_DRIVER=json
# Where the json driver keeps its data (created from data/seed.json on first run).
DATA_FILE=data/db.json
# Used by the drizzle driver and the db:* scripts. Matches docker-compose.yml.
DATABASE_URL=postgres://story:story@localhost:5432/story_map
# Optional: run the DataStore contract tests against a real Postgres too (it gets wiped!).
# TEST_DATABASE_URL=postgres://story:story@localhost:5432/story_map_test

# ── Media storage ────────────────────────────────────────────────────────────
# "none" = media are linked by URL only. "s3" = uploads to an S3-compatible bucket
# (RustFS locally via docker-compose.yml, Amazon S3 or Cloudflare R2 in production).
# NEXT_PUBLIC_: built into the client, restart `pnpm dev` / rebuild after changing it.
NEXT_PUBLIC_STORAGE_DRIVER=none
# Server → bucket. Local: http://localhost:9000. AWS S3: leave empty.
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9000
# Host the *browser* uses for presigned URLs, if different from S3_ENDPOINT (e.g. the app runs
# in a container and reaches the bucket at http://storage:9000). Empty = same as S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
# "us-east-1" for RustFS; your bucket's region for S3; "auto" for R2.
S3_REGION=us-east-1
S3_BUCKET=story-map-media
S3_ACCESS_KEY_ID=rustfs-dev
S3_SECRET_ACCESS_KEY=rustfs-dev-secret
# true for RustFS (bucket in the path); false for S3 and R2.
S3_FORCE_PATH_STYLE=true
# Largest accepted upload, in bytes (default 100 MB).
MEDIA_MAX_BYTES=104857600

# ── Place search ─────────────────────────────────────────────────────────────
# "photon" = public https://photon.komoot.io (fair use).
# For production, self-host Photon and point PHOTON_URL at it, or add another provider in src/lib/geocoding.
GEOCODER=photon
PHOTON_URL=https://photon.komoot.io

# ── Map start view ───────────────────────────────────────────────────────────
# Where maps open by default, and where the ⌂ button goes, unless a viewer picks their own place.
# "lng,lat,zoom" (a center) or "west,south,east,north" (an area to fit). Leave empty to fit all points.
# NEXT_PUBLIC_ values are built into the client: restart `pnpm dev` / rebuild after changing them.
NEXT_PUBLIC_DEFAULT_VIEW=
NEXT_PUBLIC_DEFAULT_VIEW_LABEL=
# e.g. NEXT_PUBLIC_DEFAULT_VIEW=-74.0060,40.7128,11
#      NEXT_PUBLIC_DEFAULT_VIEW_LABEL=New York
