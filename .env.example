# Copy to .env.local to override. Everything has a working default.

# Persistence driver. Only "json" exists today; add "drizzle" with Postgres later.
DATA_DRIVER=json
# Where the json driver keeps its data (created from data/seed.json on first run).
DATA_FILE=data/db.json

# Object storage for media uploads. "none" = media are linked by URL only.
# Later: "s3" (works with MinIO too) plus S3_ENDPOINT / S3_BUCKET / S3_ACCESS_KEY / S3_SECRET_KEY.
NEXT_PUBLIC_STORAGE_DRIVER=none

# Place search (the "search places" box). "photon" = public https://photon.komoot.io (fair use).
# For production, self-host Photon and point PHOTON_URL at it, or add another provider in src/lib/geocoding.
GEOCODER=photon
PHOTON_URL=https://photon.komoot.io
